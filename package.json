{
  "name": "lexlight",
  "version": "0.1.0",
  "private": true,
  "description": "Free, plain-English legal document analysis — understand contracts, leases, and terms of service in seconds.",
  "author": "Deepak Dewani",
  "homepage": "https://lexlight.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepakkumardewani/legal-plain.git"
  },
  "bugs": {
    "url": "https://github.com/deepakkumardewani/legal-plain/issues"
  },
  "keywords": [
    "legal",
    "contract-analysis",
    "plain-english",
    "nextjs",
    "ai",
    "document-analysis"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "verify": "bun run lint:fix && bun run format:check && bun run type-check "
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^2.0.35",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/view": "^6.35.0",
    "@radix-ui/react-slot": "^1.1.1",
    "@upstash/redis": "^1.34.0",
    "@vercel/analytics": "^2.0.1",
    "ai": "^6.0.188",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.1",
    "ioredis": "^5.10.1",
    "jspdf": "^2.5.2",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "pdfjs-dist": "^4.9.0",
    "radix-ui": "^1.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/coverage-v8": "^3.0.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^25.0.0",
    "oxfmt": "^0.15.0",
    "oxlint": "^0.15.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.3.6"
}
