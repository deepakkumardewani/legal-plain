ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Local dev — all Redis data (rate limits, analysis cache, share links)
REDIS_URL=redis://localhost:6379

# Production only (Upstash REST)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# PostHog analytics (server-side only)
# Get your project API key from https://app.posthog.com/settings/project
POSTHOG_KEY=
# Optional: override if using EU cloud (https://eu.i.posthog.com)
POSTHOG_HOST=
